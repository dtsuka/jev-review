{
  "name": "jev-review",
  "version": "0.1.0",
  "description": "Project-wide code review triage powered by TypeSafe AI Jev",
  "type": "module",
  "bin": { "jev-review": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "commander": "^14.0.1",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "files": ["dist"],
  "keywords": ["jev", "code-review", "security", "ai"],
  "license": "MIT"
}
